<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SfxVault.MainWindow"
        Title="SFX Vault"
        Width="1340" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#0a0a12"
        FontFamily="Inter,Segoe UI,Helvetica,Arial,sans-serif">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CaretBrush" Value="#00d9a0"/>
      <Setter Property="Foreground" Value="#e2e8f0"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Styles>

  <!-- Outer border with rounded corners -->
  <Border CornerRadius="10" Background="#0a0a12" BorderBrush="#2d2d45" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="Auto" x:Name="MenuBarRow"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Grid Grid.Row="0" Background="#12121e" x:Name="TitleBarGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Hamburger -->
        <Button Grid.Column="0" x:Name="BtnHamburger" Background="Transparent"
                BorderThickness="0" Foreground="#8892a4" FontSize="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ToolTip.Tip="Colapsar sidebar" Content="☰" Padding="4"/>

        <!-- Title -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="SFX Vault" FontSize="15" FontWeight="SemiBold" Foreground="#e2e8f0"/>
          <TextBlock Text=" ●" FontSize="10" Foreground="#00d9a0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Window controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnMin" Content="─" Width="42" Height="42" Background="Transparent"
                  BorderThickness="0" Foreground="#8892a4" FontSize="13"/>
          <Button x:Name="BtnMax" Content="□" Width="42" Height="42" Background="Transparent"
                  BorderThickness="0" Foreground="#8892a4" FontSize="13"/>
          <Button x:Name="BtnClose" Content="✕" Width="42" Height="42" Background="Transparent"
                  BorderThickness="0" Foreground="#8892a4" FontSize="13"/>
        </StackPanel>
      </Grid>

      <!-- MenuBar (auto-hide) -->
      <Border Grid.Row="1" x:Name="MenuBar" Background="#0e0e16" BorderBrush="#2d2d45"
              BorderThickness="0,0,0,1" Height="0" IsVisible="False">
        <StackPanel Orientation="Horizontal" x:Name="MenuBarPanel"/>
      </Border>

      <!-- Content -->
      <Grid Grid.Row="2" x:Name="ContentGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" x:Name="SidebarCol"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" x:Name="SidebarBorder" Background="#12121e">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Libraries header -->
            <Grid Grid.Row="0" Margin="0,14,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="LIBRERÍAS" FontSize="10" FontWeight="Bold"
                         Foreground="#8892a4" Margin="14,0,0,0" VerticalAlignment="Center"/>
              <Button Grid.Column="1" x:Name="BtnAddLib" Content="+" Width="24" Height="24"
                      FontSize="16" Background="Transparent" BorderThickness="0"
                      Foreground="#00d9a0" ToolTip.Tip="Añadir librería" Margin="0,0,8,0"/>
            </Grid>

            <!-- Sidebar scroll content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SidebarContent" Margin="0,0,0,8"/>
            </ScrollViewer>

            <!-- Status footer -->
            <Border Grid.Row="2" Background="#1c1c2e" BorderBrush="#2d2d45"
                    BorderThickness="0,1,0,0" Padding="14,8,14,8">
              <TextBlock x:Name="LblStatus" Text="Listo" FontSize="10" Foreground="#8892a4"/>
            </Border>
          </Grid>
        </Border>

        <!-- Sidebar divider -->
        <Border Grid.Column="1" Background="#2d2d45"/>

        <!-- Main area -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>

          <!-- Search bar -->
          <Border Grid.Row="0" Background="#12121e" BorderBrush="#2d2d45" BorderThickness="0,0,0,1"
                  Padding="12,10,12,10" x:Name="SearchBorder">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Foreground="#8892a4"/>
              <Panel Grid.Column="1">
                <TextBlock x:Name="SearchWatermark" Text="Buscar sonidos... (explosion, lluvia, impacto...)"
                           Foreground="#4a5568" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="TxtSearch" FontSize="14" VerticalAlignment="Center" Padding="0"/>
              </Panel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnClearSearch" Content="✕" FontSize="12" Background="Transparent"
                        BorderThickness="0" Foreground="#8892a4" Padding="6,2,6,2" ToolTip.Tip="Limpiar"/>
                <Button x:Name="BtnFavFilter" Content="⭐" FontSize="14" Background="Transparent"
                        BorderThickness="0" Foreground="#8892a4" Padding="6,2,6,2" ToolTip.Tip="Solo favoritos"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Stats row -->
          <Border Grid.Row="1" Background="#12121e" BorderBrush="#2d2d45" BorderThickness="0,0,0,1" Padding="16,6,16,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Name="LblResultCount" Text="0 archivos"
                         FontSize="12" Foreground="#8892a4" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Ordenar: " FontSize="11" Foreground="#4a5568" VerticalAlignment="Center"/>
                <Button x:Name="BtnSortName" Content="Nombre" FontSize="11" Background="Transparent"
                        BorderThickness="0" Foreground="#8892a4" Padding="6,2,6,2"/>
                <Button x:Name="BtnSortCat" Content="Categoría" FontSize="11" Background="Transparent"
                        BorderThickness="0" Foreground="#8892a4" Padding="6,2,6,2"/>
                <Button x:Name="BtnSortSize" Content="Tamaño" FontSize="11" Background="Transparent"
                        BorderThickness="0" Foreground="#8892a4" Padding="6,2,6,2"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- File list -->
          <Border Grid.Row="2" Background="#0a0a12">
            <ListBox x:Name="LstFiles" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single"/>
          </Border>

          <!-- Divider -->
          <Border Grid.Row="3" Background="#2d2d45"/>

          <!-- Player -->
          <Border Grid.Row="4" Background="#12121e" BorderBrush="#2d2d45" BorderThickness="0,1,0,0">
            <Grid Margin="14,8,14,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" x:Name="LblNowPlaying" Text="Ningún archivo seleccionado"
                         FontSize="12" Foreground="#8892a4" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

              <!-- Progress -->
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="LblCurrentTime" Text="0:00" FontSize="11" Foreground="#8892a4" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="SlProgress" Minimum="0" Maximum="1" Value="0"
                        VerticalAlignment="Center" Margin="8,0,8,0"/>
                <TextBlock Grid.Column="2" x:Name="LblTotalTime" Text="0:00" FontSize="11" Foreground="#8892a4" VerticalAlignment="Center" TextAlignment="Right"/>
              </Grid>

              <!-- Controls -->
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Volume -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <Slider x:Name="SlVolume" Minimum="0" Maximum="1" Value="0.85" Width="80" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Playback -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button x:Name="BtnPrev" Content="⏮" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#8892a4" Padding="8,2,8,2" ToolTip.Tip="Anterior"/>
                  <Button x:Name="BtnPlayPause" Content="▶" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="#00d9a0" Padding="12,2,12,2" ToolTip.Tip="Reproducir/Pausar"/>
                  <Button x:Name="BtnStop" Content="⏹" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#8892a4" Padding="8,2,8,2" ToolTip.Tip="Detener"/>
                  <Button x:Name="BtnNext" Content="⏭" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#8892a4" Padding="8,2,8,2" ToolTip.Tip="Siguiente"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnCopyFile" Content="📋 Copiar" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#8892a4" Padding="8,2,8,2" ToolTip.Tip="Copiar al portapapeles"/>
                  <Button x:Name="BtnOpenExplorer" Content="📁 Abrir" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#8892a4" Padding="8,2,8,2" ToolTip.Tip="Abrir en explorador"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
